<?xml version="1.0" encoding="utf-8"?>
<!--
  MSI definition, built with wixl (msitools) by release.sh:
  wixl -a x64 -D Version=x.y.z -D FileVersion=x.y.z.b -D ExePath=... -D IconPath=... -o out.msi otp4win.wxs
  It installs per user, without admin rights, into %LOCALAPPDATA%\Programs\otp4win.
  The UpgradeCode must never change, so new versions replace old ones.
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="otp4win" Language="1033" Version="$(var.Version)"
           Manufacturer="Maurits van der Schee" UpgradeCode="B98ED2DC-166B-4927-BB2A-65DC6A99A5A2">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="otp4win $(var.Version)" Comments="TOTP client for Windows"/>
    <Media Id="1" Cabinet="otp4win.cab" EmbedCab="yes"/>
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of otp4win is already installed."/>

    <Icon Id="otp4win.ico" SourceFile="$(var.IconPath)"/>
    <Property Id="ARPPRODUCTICON" Value="otp4win.ico"/>
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/mevdschee/otp4win"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLDIR" Name="otp4win">
            <!-- Per-user components need a registry key path, not the file. -->
            <Component Id="MainExecutable" Guid="*" Win64="yes">
              <!-- The version must be set: an unversioned file never replaces
                   the versioned exe of the old install during an upgrade, and
                   removing the old version then deletes it. -->
              <File Id="otp4win.exe" Name="otp4win.exe" Source="$(var.ExePath)"
                    DefaultVersion="$(var.FileVersion)"/>
              <RemoveFolder Id="RemoveInstallDir" On="uninstall"/>
              <RegistryValue Root="HKCU" Key="Software\otp4win" Name="exe"
                             Type="integer" Value="1" KeyPath="yes"/>
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="*">
          <Shortcut Id="otpShortcut" Name="otp4win" Description="TOTP client"
                    Target="[INSTALLDIR]otp4win.exe" WorkingDirectory="INSTALLDIR"/>
          <RegistryValue Root="HKCU" Key="Software\otp4win" Name="shortcut"
                         Type="integer" Value="1" KeyPath="yes"/>
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Main" Level="1">
      <ComponentRef Id="MainExecutable"/>
      <ComponentRef Id="StartMenuShortcut"/>
    </Feature>
  </Product>
</Wix>
